<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.ui.tab.BidderAuctionRoomController">
    <children>
        <VBox layoutX="25.0" layoutY="25.0" spacing="20.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
            <children>
                <Label fx:id="lblProductName" text="Sản phẩm đang đấu giá" textFill="#2c3e50">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>

                <HBox spacing="25.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="420.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <children>
                                <StackPane prefHeight="180.0" style="-fx-background-color: #f9f9f9; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                                    <children>
                                        <ImageView fx:id="itemImageView" fitHeight="170.0" fitWidth="380.0" pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                </StackPane>

                                <Separator />

                                <Label fx:id="lblCurrentPrice" text="GIÁ HIỆN TẠI: 0 VNĐ" textFill="#e74c3c">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <Label fx:id="lblStep" text="Bước giá tối thiểu: 0 VNĐ" />
                                <Label fx:id="lblBinPrice" text="Giá mua đứt: 0 VNĐ" textFill="#2980b9" />

                                <Separator />

                                <Label text="Nhập giá thủ công:" style="-fx-font-weight: bold;" textFill="#2c3e50" />
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <TextField fx:id="txtBidInput" prefHeight="35.0" promptText="Nhập số tiền..." HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnPlaceBid" onAction="#handlePlaceBid" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #27ae60; -fx-cursor: hand;" text="ĐẶT GIÁ" textFill="white">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>

                                <Separator />

                                <Label text="Chế độ đấu giá tự động (Auto-Bid):" style="-fx-font-weight: bold;" textFill="#d35400">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Ngưỡng dừng tối đa (Hệ thống dừng khi chạm mốc này):" style="-fx-font-size: 11px;" />
                                        <TextField fx:id="txtStopPrice" prefHeight="35.0" promptText="Ví dụ: 5000000" />
                                    </children>
                                </VBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="btnAutoBidSetup" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" onAction="#handleAutoBidSetup" prefHeight="35.0" style="-fx-background-color: #e67e22; -fx-cursor: hand;" text="BẬT AUTO-BID" textFill="white">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Button>
                                        <Button fx:id="btnStopAutoBid" disable="true" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" onAction="#handleStopAutoBid" prefHeight="35.0" style="-fx-background-color: #e74c3c; -fx-cursor: hand;" text="DỪNG AUTO-BID" textFill="white">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>

                                <Separator />

                                <Button fx:id="btnRefresh" maxWidth="1.7976931348623157E308" onAction="#manualRefresh" prefHeight="30.0" style="-fx-cursor: hand;" text="🔄 Làm mới dữ liệu" />
                            </children>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="15.0">
                            <children>
                                <LineChart fx:id="priceLineChart" title="Biến động giá thời gian thực" prefHeight="280.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                                    <xAxis>
                                        <CategoryAxis fx:id="xAxis" label="Thời gian / Lượt đấu" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis" label="Mức giá (VNĐ)" />
                                    </yAxis>
                                </LineChart>

                                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Nhật ký phòng đấu giá:">
                                            <font><Font name="System Italic" size="13.0" /></font>
                                        </Label>
                                        <TextArea fx:id="txtAreaLog" editable="false" style="-fx-font-family: 'Consolas'; -fx-font-size: 12px;" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>